# Test API. Never point mutating tests at production.
EPH_BASE_URL=https://test.emlakportfoyhavuzu.com/api
EPH_TOKEN=
EPH_SECONDARY_TOKEN=

# IDs belonging to the primary test user.
TEST_INTEREST_ID=
TEST_POST_ID=
TEST_CUSTOMER_ID=
TEST_UNIT_ID=

# IDs belonging to another test user, used only by security tests.
FOREIGN_INTEREST_ID=
FOREIGN_POST_ID=
FOREIGN_CUSTOMER_ID=
FOREIGN_UNIT_ID=

# Safety switches.
ALLOW_MUTATIONS=false
AUTO_RECALCULATE=false
REQUEST_TIMEOUT_MS=15000
POLL_INTERVAL_MS=60000
LOAD_CONCURRENCY=10
LOAD_REQUESTS=100
REPORT_DIR=./reports
