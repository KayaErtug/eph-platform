  @@index([hataVarMi])
}

model LinaKalibrasyon {
  id                String    @id @default(uuid())
  kullaniciId       String?
  rol               String?
  modul             LinaModul @default(GENEL)
  ayarBasligi       String
  ayarAciklamasi    String?
  ayarVerisi        Json
  aktifMi           Boolean   @default(true)
  baslangicTarihi   DateTime  @default(now())
  bitisTarihi       DateTime?
  olusturulmaTarihi DateTime  @default(now())
  guncellenmeTarihi DateTime  @updatedAt

  @@index([kullaniciId])
  @@index([rol])
  @@index([modul])
  @@index([aktifMi])
}

model LinaOneriBasariKaydi {
  id                String    @id @default(uuid())
  kullaniciId       String?
  oneriId           String?
  modul             LinaModul @default(GENEL)
  uygulandiMi       Boolean   @default(false)
  sonucBasariliMi   Boolean?
  sonucAciklamasi   String?
  kullaniciMemnunMu Boolean?
  etkiPuani         Int?
  olusturulmaTarihi DateTime  @default(now())
  guncellenmeTarihi DateTime  @updatedAt

  @@index([kullaniciId])
  @@index([oneriId])
  @@index([modul])
  @@index([uygulandiMi])
  @@index([sonucBasariliMi])
  @@index([etkiPuani])
}

model EPHAuthorityLetter {
  id                 String   @id @default(cuid())
  unitId             String
  authorityNo        String   @unique
  ownerName          String
  ownerPhone         String?
  ownerEmail         String?
  authorityType      String
  authorityStartDate DateTime
  authorityEndDate   DateTime
  status             String   @default("TASLAK")
  pdfUrl             String?
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  unit               Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([status])
}

