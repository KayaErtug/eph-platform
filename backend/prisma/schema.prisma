generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(uuid())
  email           String  @unique
  phone           String  @unique
  passwordHash    String
  firstName       String
  lastName        String
  profileImageUrl String?
  role            Role
  isVerified      Boolean @default(false)
  isApproved      Boolean @default(false)
  adminVisible    Boolean @default(true)

  hesapTuru      KullaniciHesapTuru @default(GERCEK)
  pilotKullaniciMi Boolean @default(false)

  memberCode  String?   @unique
  memberSince DateTime?
  trustScore  Int       @default(70)
  riskLevel   RiskLevel @default(DUSUK)

  city          String?
  district      String?
  cityPlateCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nominationPoints Int     @default(0)
  nominationQuota  Int     @default(10)
  referralCode     String? @unique

  activities              Activity[]
  applications            Application[]
  reviewedApplications    Application[]             @relation("ApplicationReviewer")
  auditLogs               AuditLog[]                @relation("AuditActor")
  activitiesAudited       AuditLog[]                @relation("AuditTargetUser")
  ConversationParticipant ConversationParticipant[]
  customers               Customer[]
  documents               Document[]
  Message                 Message[]
  NetworkPost             NetworkPost[]
  NetworkPostUpdateLog    NetworkPostUpdateLog[]
  NetworkPostFollower     NetworkPostFollower[]
  NetworkPostView         NetworkPostView[]
  NetworkNotification     NetworkNotification[]
  nominations             Nomination[]
  projects                Project[]
  tasks                   Task[]
  visits                  UserVisit[]
  pushSubscriptions       PushSubscription[]
  linaPreference          LinaPreference?
  linaPortfolioSessions   LinaPortfolioSession[]

  superAdminProfile    SUPER_ADMIN?
  reportsCreated       Report[]               @relation("ReportReporter")
  reportsResolved      Report[]               @relation("ReportResolver")
  restrictions         UserRestriction[]      @relation("RestrictedUser")
  restrictionsCreated  UserRestriction[]      @relation("RestrictionCreator")
  adminActionLogs      AdminActionLog[]       @relation("AdminActionActor")
  adminActionTargets   AdminActionLog[]       @relation("AdminActionTarget")
  announcementsCreated PlatformAnnouncement[] @relation("AnnouncementCreator")
  systemMessagesSent   SystemMessage[]        @relation("SystemMessageSender")
  systemMessagesInbox  SystemMessage[]        @relation("SystemMessageTargetUser")
}

model SUPER_ADMIN {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String   @default("Süper Admin")
  isActive    Boolean  @default(true)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id                    String           @id @default(uuid())
  code                  String           @unique
  role                  Role
  status                InvitationStatus @default(PENDING)
  maxUses               Int              @default(1)
  usedCount             Int              @default(0)
  expiresAt             DateTime

  davetKoduTuru         DavetKoduTuru    @default(REFERANSLI_BASVURU)
  adayEposta            String?
  adayAdSoyad           String?
  adayTelefon           String?
  pilotDavetiMi         Boolean          @default(false)

  olusturanKullaniciId  String?
  olusturanRol          Role?
  onayYetkiSeviyesi     OnayYetkiSeviyesi @default(MODERATOR_ADMIN_SUPER_ADMIN)

  epostaGonderildiMi    Boolean          @default(false)
  epostaGonderimTarihi  DateTime?
  epostaHataMesaji      String?

  iptalEdenKullaniciId  String?
  iptalTarihi           DateTime?
  iptalSebebi           String?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([role])
  @@index([status])
  @@index([davetKoduTuru])
  @@index([adayEposta])
  @@index([pilotDavetiMi])
  @@index([olusturanKullaniciId])
  @@index([olusturanRol])
  @@index([expiresAt])
}

model ReferralCandidate {
  id           String    @id @default(uuid())
  referralCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String    @unique
  role         Role
  isActive     Boolean   @default(true)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Document {
  id        String         @id @default(uuid())
  userId    String
  type      DocumentType
  status    DocumentStatus @default(PENDING)
  fileUrl   String
  fileName  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  city        String
  district    String
  address     String
  latitude    Float?
  longitude   Float?
  mapAddress  String?
  placeId     String?
  ownerId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [id])
  units Unit[]

  @@index([latitude, longitude])
  @@index([city, district])
}

model Unit {
  id            String     @id @default(uuid())
  projectId     String
  type          UnitType   @default(DAIRE)
  floor         Int?
  floorLabel    String?
  totalFloors   Int?
  priceCurrency String?    @default("TRY")
  number        String
  roomCount     String?
  area          Float?
  price         Float
  status        UnitStatus @default(SATILIK)
  description   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isOffMarket   Boolean    @default(false)
  isVerified    Boolean    @default(false)
  photoVerified Boolean    @default(false)
  tapuVerified  Boolean    @default(false)
  verifiedAt    DateTime?
  yetkiVerified Boolean    @default(false)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images  UnitImage[]
}

model UnitImage {
  id           String   @id @default(uuid())
  unitId       String
  url          String
  supabaseUrl  String?
  path         String
  bucket       String   @default("portfolio-images")
  originalName String?
  mimetype     String?
  size         Int?
  isCover      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([isCover])
  @@index([sortOrder])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  targetUserId   String?
  entityType     String
  entityId       String?
  reason         String
  description    String?
  status         ReportStatus @default(ACIK)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
}

model UserRestriction {
  id          String          @id @default(uuid())
  userId      String
  createdById String
  type        RestrictionType
  reason      String
  isActive    Boolean         @default(true)
  startsAt    DateTime        @default(now())
  endsAt      DateTime?
  liftedAt    DateTime?
  liftedNote  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user      User @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("RestrictionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model AdminActionLog {
  id           String   @id @default(uuid())
  actorId      String?
  targetUserId String?
  action       String
  entityType   String
  entityId     String?
  description  String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  actor      User? @relation("AdminActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model PlatformAnnouncement {
  id          String               @id @default(uuid())
  createdById String
  title       String
  content     String
  audience    AnnouncementAudience @default(TUM_UYELER)
  isActive    Boolean              @default(true)
  startsAt    DateTime             @default(now())
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  createdBy User @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([audience])
}

model SystemMessage {
  id                String                  @id @default(uuid())
  senderId          String
  visibleSenderName String                  @default("EPH Admin")
  targetType        SystemMessageTargetType
  targetUserId      String?
  targetRole        Role?

  targetCities         String[]
  targetCityPlateCodes String[]
  targetRoles          String[]

  recipientCount Int @default(0)

  category SystemMessageCategory

  customCategory String?
  title          String
  body           String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sender     User  @relation("SystemMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  targetUser User? @relation("SystemMessageTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([targetUserId])
  @@index([targetRole])
  @@index([targetType])
  @@index([category])
  @@index([isRead])
  @@index([createdAt])
}

model Nomination {
  id             String           @id @default(uuid())
  nominatorId    String
  candidateName  String
  candidateEmail String
  candidatePhone String
  candidateRole  Role
  note           String?
  status         NominationStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  nominator User @relation(fields: [nominatorId], references: [id], onDelete: Cascade)
}

model Application {
  id                    String            @id @default(uuid())
  applicantName         String
  applicantEmail        String
  applicantPhone        String
  requestedRole         Role
  message               String?

  basvuruTuru           BasvuruTuru       @default(REFERANSSIZ)
  pilotBasvuruMu        Boolean           @default(false)

  referralCode          String?
  invitationId          String?
  referrerId            String?
  referansliMi          Boolean           @default(false)
  referansDogrulandiMi  Boolean           @default(false)
  referansOlusturanId   String?

  status                ApplicationStatus @default(PENDING)
  adminNote             String?
  moderatorNote         String?
  profession            String?
  city                  String?
  district              String?

  onayYetkiSeviyesi     OnayYetkiSeviyesi @default(ADMIN_SUPER_ADMIN)
  onaylayanRol          Role?

  ipAddress             String?
  userAgent             String?
  isVip                 Boolean           @default(false)
  isRisky               Boolean           @default(false)
  riskNote              String?

  platformAccepted      Boolean           @default(false)
  kvkkAccepted          Boolean           @default(false)
  privacyAccepted       Boolean           @default(false)
  userAgreementAccepted Boolean           @default(false)
  legalAcceptedAt       DateTime?

  reviewedAt            DateTime?
  reviewedById          String?

  rejectedAt            DateTime?
  rejectedById          String?
  rejectReason          String?

  epostaGonderildiMi    Boolean           @default(false)
  epostaGonderimTarihi  DateTime?
  epostaHataMesaji      String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  referrer   User? @relation(fields: [referrerId], references: [id])
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([applicantEmail])
  @@index([requestedRole])
  @@index([basvuruTuru])
  @@index([pilotBasvuruMu])
  @@index([referralCode])
  @@index([invitationId])
  @@index([referansliMi])
  @@index([referansOlusturanId])
  @@index([status])
  @@index([onayYetkiSeviyesi])
  @@index([reviewedById])
  @@index([createdAt])
}

model Lead {
  id           String   @id @default(uuid())
  fullName     String?
  phone        String?
  email        String?
  profession   String?
  city         String?
  interest     String?
  conversation String?
  source       String   @default("LINA")
  createdAt    DateTime @default(now())
}

model Customer {
  id              String         @id @default(uuid())
  ownerId         String
  firstName       String
  lastName        String
  phone           String?
  email           String?
  city            String?
  profession      String?
  company         String?
  budget          Float?
  interestedArea  String?
  interestedType  String?
  source          String?
  status          CustomerStatus @default(YENI_LEAD)
  tags            String[]
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  activities Activity[]
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks      Task[]
}

model Activity {
  id         String       @id @default(uuid())
  customerId String
  userId     String
  type       ActivityType
  note       String
  createdAt  DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id         String     @id @default(uuid())
  customerId String
  userId     String
  title      String
  dueDate    DateTime?
  status     TaskStatus @default(BEKLIYOR)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserVisit {
  id        String   @id @default(uuid())
  userId    String?
  page      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Conversation {
  id        String             @id
  postId    String?
  title     String
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime

  NetworkPost             NetworkPost?              @relation(fields: [postId], references: [id])
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

model ConversationParticipant {
  id             String    @id
  conversationId String
  userId         String
  createdAt      DateTime  @default(now())
  lastReadAt     DateTime?

  Conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  Conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model NetworkPost {
  id           String            @id
  userId       String
  type         String
  title        String
  description  String
  city         String?
  district     String?
  neighborhood String?
  budget       Float?
  urgency      String?
  visibility   NetworkVisibility @default(TUM_EPH)
  tags         String[]
  expiresAt    DateTime
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime

  Conversation Conversation[]
  updateLogs   NetworkPostUpdateLog[]
  followers    NetworkPostFollower[]
  views        NetworkPostView[]
  User         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetworkPostUpdateLog {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  summary   String
  changes   Json
  createdAt DateTime @default(now())

  post NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetworkPostFollower {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model NetworkPostView {
  id        String   @id @default(uuid())
  postId    String
  userId    String?
  createdAt DateTime @default(now())

  post NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model NetworkNotification {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}





model LinaPreference {
  id        String   @id @default(uuid())
  userId    String   @unique

  voiceEnabled                 Boolean @default(false)
  dashboardVoiceSummaryEnabled Boolean @default(false)
  crmVoiceReminderEnabled      Boolean @default(false)
  networkVoiceSummaryEnabled   Boolean @default(false)
  poolVoiceSummaryEnabled      Boolean @default(false)

  quietHoursEnabled Boolean @default(true)
  quietHoursStart   String  @default("22:00")
  quietHoursEnd     String  @default("08:00")

  urgentVoiceEnabled Boolean @default(false)

  summaryStyle String @default("normal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}









model LinaPortfolioSession {
  id     String @id @default(uuid())
  userId String

  mode        String @default("PORTFOLIO_CREATE")
  sessionType String @default("PORTFOLIO_DRAFT")
  title       String?

  propertyType    String?
  transactionType String?
  step            String @default("TRANSACTION_TYPE")

  city         String?
  district     String?
  neighborhood String?

  roomCount          String?
  squareMeter        Float?
  floor              String?
  buildingFloorCount Int?
  price              Float?
  currency           String @default("TRY")

  status         String   @default("DRAFT")
  confirmationStatus String @default("WAITING")
  stateJson      Json?

  lastActivityAt DateTime @default(now())
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActivityAt])
}


model AuditLog {
  id           String      @id @default(uuid())
  actorId      String?
  targetUserId String?
  action       AuditAction
  entityType   String
  entityId     String?
  description  String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id])
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id])
}

enum Role {
  EMLAKCI
  MUTEAHHIT
  INSAAT_FIRMASI
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum RiskLevel {
  DUSUK
  ORTA
  YUKSEK
  KRITIK
}

enum ReportStatus {
  ACIK
  INCELENIYOR
  COZULDU
  REDDEDILDI
}

enum RestrictionType {
  GIRIS_ENGELI
  PAYLASIM_ENGELI
  MESAJ_ENGELI
  ILAN_ENGELI
  GECICI_ASKI
  KALICI_ASKI
}

enum AnnouncementAudience {
  TUM_UYELER
  EMLAKCILAR
  MUTEAHHITLER
  INSAAT_FIRMALARI
  ADMINLER
}

enum SystemMessageTargetType {
  TEK_KULLANICI
  COKLU_KULLANICI

  TUM_KULLANICILAR

  EMLAKCILAR
  MUTEAHHITLER
  INSAAT_FIRMALARI

  ADMINLER
  SUPER_ADMINLER

  SEHIRLER
  SEHIRLER_VE_ROLLER

  OZEL_GRUP
}

enum SystemMessageCategory {
  BILGILENDIRME
  SIKAYET_YANITI
  ONERI_YANITI
  UYARI
  DUYURU
  HESAP_ISLEMI
  ILAN_ISLEMI
  UYELIK_PAKET_ISLEMI
  EVRAK_DOGRULAMA_ISLEMI
  NETWORK_ISLEMI
  GUVENLIK_BILDIRIMI
  BAKIM_TEKNIK_BILGILENDIRME
  ODEME_FATURA_BILGILENDIRMESI
  KURAL_IHLALI_BILDIRIMI
  DESTEK_YANITI
  DIGER
}

enum InvitationStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum BasvuruTuru {
  REFERANSSIZ
  REFERANSLI
  PILOT
}

enum OnayYetkiSeviyesi {
  MODERATOR_ADMIN_SUPER_ADMIN
  ADMIN_SUPER_ADMIN
  SUPER_ADMIN
}

enum DavetKoduTuru {
  REFERANSLI_BASVURU
  PILOT_DAVETI
  YONETICI_DAVETI
}

enum DocumentType {
  VERGI_LEVHASI
  YETKI_BELGESI
  TICARET_SICIL
  KIMLIK
  DIGER
  MYK_BELGESI
  IMZA_SIRKULERI
  FAALIYET_BELGESI
  IS_BITIRME_BELGESI
  YAMBIS_BELGESI
  REFERANS_PROJE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitStatus {
  SATILIK
  KIRALIK
  GUNLUK_KIRALIK
  DEVREN_SATILIK
  DEVREN_KIRALIK
  ON_SATIS
  PROJE_ASAMASI
  YAKINDA_SATISTA
  INSAAT_HALINDE
  TESLIME_HAZIR
  HEMEN_TESLIM
  INSAAT_PROJESI
  KAT_KARSILIGI
  HASILAT_PAYLASIMLI
  REZERVE
  SATILDI
  KIRALANDII
  PASIF
}

enum UnitType {
  DAIRE
  REZIDANS
  VILLA
  YAZLIK
  VILLA_TERAS
  VILLA_GARDEN
  DUBLEKS_VILLA
  TRIPLEKS_VILLA
  MUSTAK_EV
  KOY_EVI
  TAS_EV
  AHSAP_EV
  PREFABRIK_EV
  CELIK_KONSTRUKSIYON
  TINY_HOUSE
  BUNGALOV
  DAG_EVI
  YAYLA_EVI
  GOL_EVI
  BAG_EVI
  CIFTLIK_EVI
  HOBI_BAHCESI_EVI
  MAGARA_EV
  KOSK_YALI
  YALI
  YALI_DAIRESI
  KONAK
  PENTHOUSE
  LOFT
  LOFT_DUBLEKS
  MARINA_RESIDENCE
  GOLF_RESIDENCE
  SAHIL_RESIDENCE
  DAG_RESIDENCE
  SKY_RESIDENCE
  OZEL_HAVUZLU_VILLA
  OZEL_ISKELELI_VILLA
  AKILLI_VILLA
  ULTRA_LUKS_VILLA
  DUKKAN_MAGAZA
  OFIS_BURO
  FABRIKA_URETIM_TESISI
  ATOLYE
  TICARI_ISLETME
  HOME_OFFICE
  PLAZA_KATI
  SHOWROOM
  IS_HANI_KATI
  IS_MERKEZI
  PAYLASIMLI_OFIS
  DEPO_ANTREPO
  LOJISTIK_MERKEZI
  FABRIKA_ATOLYE
