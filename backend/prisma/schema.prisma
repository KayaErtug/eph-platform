generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                       @id @default(uuid())
  email                       String                       @unique
  phone                       String                       @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  role                        Role
  isVerified                  Boolean                      @default(false)
  emailVerifiedAt             DateTime?
  emailVerificationCodeHash   String?
  emailVerificationExpiresAt  DateTime?
  emailVerificationAttempts   Int                          @default(0)
  emailVerificationLastSentAt DateTime?
  passwordResetCodeHash       String?
  passwordResetExpiresAt      DateTime?
  passwordResetAttempts       Int                          @default(0)
  passwordResetLastSentAt     DateTime?
  passwordResetVersion        Int                          @default(0)
  isApproved                  Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  nominationPoints            Int                          @default(0)
  nominationQuota             Int                          @default(10)
  referralCode                String?                      @unique
  adminVisible                Boolean                      @default(true)
  profileImageUrl             String?
  memberCode                  String?                      @unique
  memberSince                 DateTime?
  riskLevel                   RiskLevel                    @default(DUSUK)
  trustScore                  Int                          @default(70)
  city                        String?
  cityPlateCode               String?
  district                    String?
  hesapTuru                   KullaniciHesapTuru           @default(GERCEK)
  pilotKullaniciMi            Boolean                      @default(false)
  officeId                    String?
  activities                  Activity[]
  adminActionLogs             AdminActionLog[]             @relation("AdminActionActor")
  adminActionTargets          AdminActionLog[]             @relation("AdminActionTarget")
  applications                Application[]
  reviewedApplications        Application[]                @relation("ApplicationReviewer")
  auditLogs                   AuditLog[]                   @relation("AuditActor")
  activitiesAudited           AuditLog[]                   @relation("AuditTargetUser")
  ConversationParticipant     ConversationParticipant[]
  customers                   Customer[]
  documents                   Document[]
  linaPortfolioSessions       LinaPortfolioSession[]
  linaPreference              LinaPreference?
  linaOturumlari              LinaOturum[]
  linaGunSonuOnaylari         LinaGunSonuOnayi[]
  Message                     Message[]
  NetworkNotification         NetworkNotification[]
  NetworkPost                 NetworkPost[]
  NetworkPostFollower         NetworkPostFollower[]
  NetworkPostUpdateLog        NetworkPostUpdateLog[]
  NetworkPostView             NetworkPostView[]
  nominations                 Nomination[]
  ownedOffices                Office[]                     @relation("OfficeOwner")
  announcementsCreated        PlatformAnnouncement[]       @relation("AnnouncementCreator")
  portfolioAuthorityApprovals PortfolioAuthorityDocument[] @relation("PortfolioAuthorityApprover")
  projects                    Project[]
  projectInventoryBatches     ProjectInventoryBatch[]      @relation("ProjectInventoryBatchCreator")
  projectDesignReviewRequests ProjectDesignReviewRequest[] @relation("ProjectDesignReviewRequester")
  projectDesignReviews        ProjectDesignReviewRequest[] @relation("ProjectDesignReviewReviewer")
  salesUnits                  Unit[]                       @relation("UnitSalesRepresentative")
  pushSubscriptions           PushSubscription[]
  reportsCreated              Report[]                     @relation("ReportReporter")
  reportsResolved             Report[]                     @relation("ReportResolver")
  superAdminProfile           SUPER_ADMIN?
  systemMessagesSent          SystemMessage[]              @relation("SystemMessageSender")
  systemMessagesInbox         SystemMessage[]              @relation("SystemMessageTargetUser")
  tasks                       Task[]
  ledTeams                    Team[]                       @relation("TeamLeader")
  teamMemberships             TeamMember[]
  office                      Office?                      @relation("OfficeUsers", fields: [officeId], references: [id])
  capabilitiesCreated         UserCapability[]             @relation("CapabilityCreator")
  capabilities                UserCapability[]             @relation("UserCapabilities")
  restrictionsCreated         UserRestriction[]            @relation("RestrictionCreator")
  restrictions                UserRestriction[]            @relation("RestrictedUser")
  visits                      UserVisit[]
  hediyeKontorHavuzlari       HediyeKontorHavuzu[]         @relation("GiftPoolCreator")
  hediyeKontorGonderimleri    HediyeKontorDagitimi[]       @relation("GiftCreditSender")
  hediyeKontorAlimlari        HediyeKontorDagitimi[]       @relation("GiftCreditRecipient")

  @@index([officeId])
}

model SUPER_ADMIN {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String   @default("Süper Admin")
  isActive    Boolean  @default(true)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Office {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerUserId String?
  city        String?
  district    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User?    @relation("OfficeOwner", fields: [ownerUserId], references: [id])
  teams       Team[]
  users       User[]   @relation("OfficeUsers")

  @@index([ownerUserId])
  @@index([city, district])
  @@index([isActive])
}

model Team {
  id        String       @id @default(uuid())
  officeId  String
  name      String
  leaderId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  leader    User?        @relation("TeamLeader", fields: [leaderId], references: [id])
  office    Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@unique([officeId, name])
  @@index([officeId])
  @@index([leaderId])
  @@index([isActive])
}

model TeamMember {
  id        String    @id @default(uuid())
  teamId    String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([isActive])
}

model UserCapability {
  id          String     @id @default(uuid())
  userId      String
  capability  Capability
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   User?      @relation("CapabilityCreator", fields: [createdById], references: [id])
  user        User       @relation("UserCapabilities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId])
  @@index([capability])
  @@index([createdById])
}

model Invitation {
  id                   String            @id @default(uuid())
  code                 String            @unique
  role                 Role
  status               InvitationStatus  @default(PENDING)
  maxUses              Int               @default(1)
  usedCount            Int               @default(0)
  expiresAt            DateTime
  createdAt            DateTime          @default(now())
  adayAdSoyad          String?
  adayEposta           String?
  adayTelefon          String?
  davetKoduTuru        DavetKoduTuru     @default(REFERANSLI_BASVURU)
  epostaGonderildiMi   Boolean           @default(false)
  epostaGonderimTarihi DateTime?
  epostaHataMesaji     String?
  iptalEdenKullaniciId String?
  iptalSebebi          String?
  iptalTarihi          DateTime?
  olusturanKullaniciId String?
  olusturanRol         Role?
  onayYetkiSeviyesi    OnayYetkiSeviyesi @default(MODERATOR_ADMIN_SUPER_ADMIN)
  pilotDavetiMi        Boolean           @default(false)
  updatedAt            DateTime          @updatedAt

  @@index([role])
  @@index([status])
  @@index([davetKoduTuru])
  @@index([adayEposta])
  @@index([pilotDavetiMi])
  @@index([olusturanKullaniciId])
  @@index([olusturanRol])
  @@index([expiresAt])
}

model ReferralCandidate {
  id           String    @id @default(uuid())
  referralCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String    @unique
  role         Role
  isActive     Boolean   @default(true)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Document {
  id        String         @id @default(uuid())
  userId    String
  type      DocumentType
  status    DocumentStatus @default(PENDING)
  fileUrl   String
  fileName  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                           String                       @id @default(uuid())
  name                         String
  code                         String?
  description                  String?
  city                         String
  district                     String
  neighborhood                 String?
  address                      String
  adaNo                        String?
  parselNo                     String?
  ownerId                      String
  completionPercent            Int?
  defaultDeliveryDate          DateTime?
  declaredIndependentUnitCount Int?
  declaredSalesInventoryCount  Int?
  plannedUnitTypes             UnitType[]                   @default([])
  geometryType                 ProjectGeometryType          @default(DIKDORTGEN)
  wizardStep                   ProjectWizardStep            @default(PROJE_BILGILERI)
  setupStatus                  ProjectSetupStatus           @default(TASLAK)
  needsSoftwareTeamReview      Boolean                      @default(false)
  isActive                     Boolean                      @default(true)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  latitude                     Float?
  longitude                    Float?
  mapAddress                   String?
  placeId                      String?
  owner                        User                         @relation(fields: [ownerId], references: [id])
  units                        Unit[]
  blocks                       ProjectBlock[]
  spaces                       ProjectSpace[]
  designReviewRequests         ProjectDesignReviewRequest[]
  inventoryBatches             ProjectInventoryBatch[]
  mediaPackages                ProjectMediaPackage[]

  @@unique([ownerId, code])
  @@index([ownerId])
  @@index([latitude, longitude])
  @@index([city, district, neighborhood])
  @@index([geometryType])
  @@index([wizardStep])
  @@index([setupStatus])
  @@index([needsSoftwareTeamReview])
  @@index([isActive])
}

model ProjectBlock {
  id              String                 @id @default(uuid())
  projectId       String
  sourceBatchId   String?
  code            String
  normalizedCode  String
  name            String?
  geometryType    ProjectGeometryType    @default(DIKDORTGEN)
  facadeViewCount Int                    @default(1)
  sortOrder       Int                    @default(0)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceBatch     ProjectInventoryBatch? @relation("ProjectBlockSourceBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)
  floors          ProjectFloor[]
  units           Unit[]
  spaces          ProjectSpace[]

  @@unique([projectId, normalizedCode])
  @@index([projectId, sortOrder])
  @@index([sourceBatchId])
  @@index([geometryType])
  @@index([isActive])
}

model ProjectFloor {
  id            String                 @id @default(uuid())
  blockId       String
  sourceBatchId String?
  level         Int
  label         String
  floorType     ProjectFloorType       @default(NORMAL)
  sortOrder     Int                    @default(0)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  block         ProjectBlock           @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sourceBatch   ProjectInventoryBatch? @relation("ProjectFloorSourceBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)
  units         Unit[]
  spaces        ProjectSpace[]

  @@unique([blockId, level])
  @@index([blockId, sortOrder])
  @@index([sourceBatchId])
  @@index([floorType])
  @@index([isActive])
}

model ProjectSpace {
  id                String                   @id @default(uuid())
  projectId         String
  blockId           String?
  floorId           String?
  code              String
  name              String
  spaceType         ProjectSpaceType
  customTypeName    String?
  legalStatus       ProjectLegalStatus
  commercialPurpose ProjectCommercialPurpose
  grossArea         Float?
  description       String?
  isCustomerVisible Boolean                  @default(true)
  sortOrder         Int                      @default(0)
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  block             ProjectBlock?            @relation(fields: [blockId], references: [id], onDelete: SetNull)
  floor             ProjectFloor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)

  @@unique([projectId, code])
  @@index([projectId])
  @@index([blockId])
  @@index([floorId])
  @@index([spaceType])
  @@index([legalStatus])
  @@index([commercialPurpose])
  @@index([isCustomerVisible])
  @@index([isActive])
}

model ProjectDesignReviewRequest {
  id               String                    @id @default(uuid())
  projectId        String
  requestedById    String
  reviewedById     String?
  status           ProjectDesignReviewStatus @default(BEKLIYOR)
  geometryNotes    String?
  userMessage      String?
  softwareTeamNote String?
  attachments      Json?
  requestedAt      DateTime                  @default(now())
  reviewedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy      User                      @relation("ProjectDesignReviewRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                     @relation("ProjectDesignReviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([status])
  @@index([requestedAt])
}

model ProjectMediaPackage {
  id        String                  @id @default(uuid())
  projectId String
  code      String
  name      String
  type      ProjectMediaPackageType
  unitType  UnitType?
  roomCount String?
  isDefault Boolean                 @default(false)
  isActive  Boolean                 @default(true)
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets    ProjectMediaAsset[]
  units     Unit[]

  @@unique([projectId, code])
  @@index([projectId, type])
  @@index([projectId, unitType, roomCount])
  @@index([projectId, isDefault])
  @@index([isActive])
  @@index([sortOrder])
}

model ProjectMediaAsset {
  id           String              @id @default(uuid())
  packageId    String
  url          String
  supabaseUrl  String?
  path         String
  bucket       String              @default("portfolio-images")
  originalName String?
  mimetype     String?
  size         Int?
  isCover      Boolean             @default(false)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  package      ProjectMediaPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([packageId, isCover])
  @@index([packageId, sortOrder])
}

model ProjectInventoryBatch {
  id                String                      @id @default(uuid())
  projectId         String
  createdById       String
  originalBatchId   String?
  type              ProjectInventoryBatchType
  status            ProjectInventoryBatchStatus @default(UPLOADED)
  idempotencyKey    String
  inputHash         String?
  sourceFileName    String?
  sourceFileUrl     String?
  sourceText        String?
  templateVersion   String?
  totalRows         Int                         @default(0)
  processedRows     Int                         @default(0)
  validRows         Int                         @default(0)
  invalidRows       Int                         @default(0)
  createdCount      Int                         @default(0)
  updatedCount      Int                         @default(0)
  skippedCount      Int                         @default(0)
  failedCount       Int                         @default(0)
  progressPercent   Int                         @default(0)
  validationSummary Json?
  errorSummary      Json?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelRequestedAt DateTime?
  cancelledAt       DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  project           Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User                        @relation("ProjectInventoryBatchCreator", fields: [createdById], references: [id])
  originalBatch     ProjectInventoryBatch?      @relation("ProjectInventoryBatchRollback", fields: [originalBatchId], references: [id], onDelete: SetNull)
  rollbackBatches   ProjectInventoryBatch[]     @relation("ProjectInventoryBatchRollback")
  items             ProjectInventoryBatchItem[]
  createdBlocks     ProjectBlock[]              @relation("ProjectBlockSourceBatch")
  createdFloors     ProjectFloor[]              @relation("ProjectFloorSourceBatch")
  createdUnits      Unit[]                      @relation("UnitSourceBatch")

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status])
  @@index([projectId, type])
  @@index([createdById])
  @@index([originalBatchId])
  @@index([inputHash])
  @@index([createdAt])
}

model ProjectInventoryBatchItem {
  id             String                          @id @default(uuid())
  batchId        String
  unitId         String?
  sequence       Int
  sourceRow      Int?
  naturalKey     String?
  action         ProjectInventoryBatchItemAction @default(CREATE)
  status         ProjectInventoryBatchItemStatus @default(PENDING)
  rawData        Json?
  normalizedData Json?
  errors         Json?
  warnings       Json?
  beforeData     Json?
  afterData      Json?
  afterHash      String?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  batch          ProjectInventoryBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  unit           Unit?                           @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([batchId, sequence])
  @@index([batchId, status])
  @@index([batchId, action])
  @@index([unitId])
  @@index([naturalKey])
}

model Unit {
  id                     String                       @id @default(uuid())
  projectId              String
  blockId                String?
  floorId                String?
  sourceBatchId          String?
  salesRepresentativeId  String?
  mediaPackageId         String?
  inventoryCode          String?
  externalRef            String?
  inventorySortOrder     Int                          @default(0)
  type                   UnitType                     @default(DAIRE)
  legalStatus            ProjectLegalStatus           @default(TAPUDA_BAGIMSIZ_BOLUM)
  commercialPurpose      ProjectCommercialPurpose     @default(SATISA_SUNULACAK)
  isSalesInventory       Boolean                      @default(true)
  floor                  Int?
  number                 String?
  roomCount              String?
  conceptLabel           String?
  area                   Float?
  netArea                Float?
  grossArea              Float?
  facades                String[]                     @default([])
  deliveryDate           DateTime?
  price                  Float
  status                 UnitStatus                   @default(SATILIK)
  description            String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  isOffMarket            Boolean                      @default(false)
  isVerified             Boolean                      @default(false)
  photoVerified          Boolean                      @default(false)
  tapuVerified           Boolean                      @default(false)
  verifiedAt             DateTime?
  yetkiVerified          Boolean                      @default(false)
  floorLabel             String?
  priceCurrency          String?                      @default("TRY")
  totalFloors            Int?
  approvalNote           String?
  approvalStatus         PortfolioApprovalStatus      @default(TASLAK)
  approvedAt             DateTime?
  isPoolVisible          Boolean                      @default(false)
  poolPublishedAt        DateTime?
  poolRemovedAt          DateTime?
  rejectedAt             DateTime?
  submittedForApprovalAt DateTime?
  deedOwnerEmail         String?
  deedOwnerFullName      String?
  deedOwnerPhone         String?
  features               String[]                     @default([])
  availableCreditAmount  Float?
  doorAccessInfo         String?
  adaNo                  String?
  parselNo               String?
  customerProperties     CustomerProperty[]
  authorityLetters       EPHAuthorityLetter[]
  authorityDocuments     PortfolioAuthorityDocument[]
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  block                  ProjectBlock?                @relation(fields: [blockId], references: [id], onDelete: SetNull)
  projectFloor           ProjectFloor?                @relation(fields: [floorId], references: [id], onDelete: SetNull)
  sourceBatch            ProjectInventoryBatch?       @relation("UnitSourceBatch", fields: [sourceBatchId], references: [id], onDelete: SetNull)
  salesRepresentative    User?                        @relation("UnitSalesRepresentative", fields: [salesRepresentativeId], references: [id], onDelete: SetNull)
  mediaPackage           ProjectMediaPackage?         @relation(fields: [mediaPackageId], references: [id], onDelete: SetNull)
  batchItems             ProjectInventoryBatchItem[]
  images                 UnitImage[]

  @@unique([projectId, inventoryCode])
  @@unique([projectId, externalRef])
  @@unique([projectId, blockId, floorId, number])
  @@index([projectId, blockId, floorId])
  @@index([projectId, status])
  @@index([projectId, isSalesInventory])
  @@index([legalStatus])
  @@index([commercialPurpose])
  @@index([blockId])
  @@index([floorId])
  @@index([sourceBatchId])
  @@index([salesRepresentativeId])
  @@index([mediaPackageId])
  @@index([deliveryDate])
  @@index([approvalStatus])
  @@index([isPoolVisible])
  @@index([availableCreditAmount])
}

model UnitImage {
  id           String   @id @default(uuid())
  unitId       String
  url          String
  supabaseUrl  String?
  path         String
  bucket       String   @default("portfolio-images")
  originalName String?
  mimetype     String?
  size         Int?
  isCover      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([isCover])
  @@index([sortOrder])
}

model PortfolioAuthorityDocument {
  id              String                 @id @default(uuid())
  unitId          String
  authorityType   PortfolioAuthorityType
  fileUrl         String
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  approved        Boolean                @default(false)
  approvedById    String?
  approvedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  documentSide    String?
  analyzedAt      DateTime?
  confidenceScore Int?
  documentType    String?
  linaSummary     String?
  ocrQualityScore Int?
  qrDetected      Boolean?
  riskLevel       String?
  approvedBy      User?                  @relation("PortfolioAuthorityApprover", fields: [approvedById], references: [id])
  unit            Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([authorityType])
  @@index([approved])
  @@index([approvedById])
  @@index([documentSide])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  targetUserId   String?
  entityType     String
  entityId       String?
  reason         String
  description    String?
  status         ReportStatus @default(ACIK)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
}

model UserRestriction {
  id          String          @id @default(uuid())
  userId      String
  createdById String
  type        RestrictionType
  reason      String
  isActive    Boolean         @default(true)
  startsAt    DateTime        @default(now())
  endsAt      DateTime?
  liftedAt    DateTime?
  liftedNote  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("RestrictionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  user        User            @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model AdminActionLog {
  id           String   @id @default(uuid())
  actorId      String?
  targetUserId String?
  action       String
  entityType   String
  entityId     String?
  description  String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AdminActionActor", fields: [actorId], references: [id])
  targetUser   User?    @relation("AdminActionTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model TuranQuote {
  id          String   @id @default(uuid())
  text        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
}

model PlatformAnnouncement {
  id          String               @id @default(uuid())
  createdById String
  title       String
  content     String
  audience    AnnouncementAudience @default(TUM_UYELER)
  isActive    Boolean              @default(true)
  startsAt    DateTime             @default(now())
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([audience])
}

model SystemMessage {
  id                   String                  @id @default(uuid())
  senderId             String
  visibleSenderName    String                  @default("EPH Admin")
  targetType           SystemMessageTargetType
  targetUserId         String?
  targetRole           Role?
  category             SystemMessageCategory
  customCategory       String?
  title                String
  body                 String
  isRead               Boolean                 @default(false)
  readAt               DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  recipientCount       Int                     @default(0)
  targetCities         String[]
  targetCityPlateCodes String[]
  targetRoles          String[]
  sender               User                    @relation("SystemMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  targetUser           User?                   @relation("SystemMessageTargetUser", fields: [targetUserId], references: [id])

  @@index([senderId])
  @@index([targetUserId])
  @@index([targetRole])
  @@index([targetType])
  @@index([category])
  @@index([isRead])
  @@index([createdAt])
}

model Nomination {
  id             String           @id @default(uuid())
  nominatorId    String
  candidateName  String
  candidateEmail String
  candidatePhone String
  candidateRole  Role
  note           String?
  status         NominationStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  nominator      User             @relation(fields: [nominatorId], references: [id], onDelete: Cascade)
}

model Application {
  id                    String            @id @default(uuid())
  applicantName         String
  applicantEmail        String
  applicantPhone        String
  requestedRole         Role
  message               String?
  referralCode          String?
  referrerId            String?
  status                ApplicationStatus @default(PENDING)
  adminNote             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  city                  String?
  ipAddress             String?
  isRisky               Boolean           @default(false)
  isVip                 Boolean           @default(false)
  kvkkAccepted          Boolean           @default(false)
  legalAcceptedAt       DateTime?
  platformAccepted      Boolean           @default(false)
  privacyAccepted       Boolean           @default(false)
  profession            String?
  reviewedAt            DateTime?
  reviewedById          String?
  riskNote              String?
  userAgent             String?
  userAgreementAccepted Boolean           @default(false)
  basvuruTuru           BasvuruTuru       @default(REFERANSSIZ)
  district              String?
  epostaGonderildiMi    Boolean           @default(false)
  epostaGonderimTarihi  DateTime?
  epostaHataMesaji      String?
  invitationId          String?
  moderatorNote         String?
  onayYetkiSeviyesi     OnayYetkiSeviyesi @default(ADMIN_SUPER_ADMIN)
  onaylayanRol          Role?
  pilotBasvuruMu        Boolean           @default(false)
  referansDogrulandiMi  Boolean           @default(false)
  referansOlusturanId   String?
  referansliMi          Boolean           @default(false)
  rejectReason          String?
  rejectedAt            DateTime?
  rejectedById          String?
  referrer              User?             @relation(fields: [referrerId], references: [id])
  reviewedBy            User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([applicantEmail])
  @@index([requestedRole])
  @@index([basvuruTuru])
  @@index([pilotBasvuruMu])
  @@index([referralCode])
  @@index([invitationId])
  @@index([referansliMi])
  @@index([referansOlusturanId])
  @@index([status])
  @@index([onayYetkiSeviyesi])
  @@index([reviewedById])
  @@index([createdAt])
}

model Lead {
  id           String   @id @default(uuid())
  fullName     String?
  phone        String?
  email        String?
  profession   String?
  city         String?
  interest     String?
  conversation String?
  source       String   @default("LINA")
  createdAt    DateTime @default(now())
}

model Customer {
  id              String             @id @default(uuid())
  ownerId         String
  firstName       String
  lastName        String
  phone           String?
  email           String?
  city            String?
  profession      String?
  company         String?
  budget          Float?
  interestedArea  String?
  interestedType  String?
  source          String?
  status          CustomerStatus     @default(YENI_LEAD)
  tags            String[]           @default([])
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  roles           CustomerRole[]     @default([])
  activities      Activity[]
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  interests       CustomerInterest[]
  properties      CustomerProperty[]
  tasks           Task[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([updatedAt])
}

model CustomerProperty {
  id           String                   @id @default(uuid())
  customerId   String
  unitId       String
  relationType CustomerPropertyRelation
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  unit         Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([customerId, unitId, relationType])
  @@index([customerId])
  @@index([unitId])
  @@index([relationType])
  @@index([createdAt])
}

model CustomerInterest {
  id             String                   @id @default(uuid())
  customerId     String
  title          String?
  city           String?
  district       String?
  neighborhood   String?
  propertyTypes  UnitType[]               @default([])
  statuses       UnitStatus[]             @default([])
  minBudget      Float?
  maxBudget      Float?
  priceCurrency  String                   @default("TRY")
  minArea        Float?
  maxArea        Float?
  roomCounts     String[]                 @default([])
  features       String[]                 @default([])
  purchaseIntent CustomerPurchaseIntent   @default(BELIRSIZ)
  priority       CustomerInterestPriority @default(NORMAL)
  notes          String?
  isActive       Boolean                  @default(true)
  lastMatchedAt  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  customer       Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([city, district, neighborhood])
  @@index([isActive])
  @@index([priority])
  @@index([purchaseIntent])
  @@index([createdAt])
}

model Activity {
  id         String       @id @default(uuid())
  customerId String
  userId     String
  type       ActivityType
  note       String
  createdAt  DateTime     @default(now())
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id         String     @id @default(uuid())
  customerId String
  userId     String
  title      String
  dueDate    DateTime?
  status     TaskStatus @default(BEKLIYOR)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserVisit {
  id        String   @id @default(uuid())
  userId    String?
  page      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Conversation {
  id                      String                    @id
  postId                  String?
  title                   String
  status                  ConversationStatus        @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  NetworkPost             NetworkPost?              @relation(fields: [postId], references: [id])
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

model ConversationParticipant {
  id             String       @id
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  lastReadAt     DateTime?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model NetworkPost {
  id           String                 @id
  userId       String
  type         String
  title        String
  description  String
  city         String?
  district     String?
  neighborhood String?
  budget       Float?
  minArea      Float?
  maxArea      Float?
  minRoom      Int?
  maxRoom      Int?
  minBudget    Float?
  maxBudget    Float?
  areas        Json?
  urgency      String?
  visibility   NetworkVisibility      @default(TUM_EPH)
  tags         String[]
  expiresAt    DateTime
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime
  Conversation Conversation[]
  User         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers    NetworkPostFollower[]
  updateLogs   NetworkPostUpdateLog[]
  views        NetworkPostView[]
}

model NetworkPostUpdateLog {
  id        String      @id @default(uuid())
  postId    String
  userId    String
  summary   String
  changes   Json
  createdAt DateTime    @default(now())
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetworkPostFollower {
  id        String      @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model NetworkPostView {
  id        String      @id @default(uuid())
  postId    String
  userId    String?
  createdAt DateTime    @default(now())
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model NetworkNotification {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinaPreference {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  voiceEnabled                 Boolean  @default(false)
  dashboardVoiceSummaryEnabled Boolean  @default(false)
  crmVoiceReminderEnabled      Boolean  @default(false)
  networkVoiceSummaryEnabled   Boolean  @default(false)
  poolVoiceSummaryEnabled      Boolean  @default(false)
  quietHoursEnabled            Boolean  @default(true)
  quietHoursStart              String   @default("22:00")
  quietHoursEnd                String   @default("08:00")
  urgentVoiceEnabled           Boolean  @default(false)
  summaryStyle                 String   @default("normal")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LinaPortfolioSession {
  id                 String    @id @default(uuid())
  userId             String
  mode               String    @default("PORTFOLIO_CREATE")
  sessionType        String    @default("PORTFOLIO_DRAFT")
  title              String?
  propertyType       String?
  transactionType    String?
  step               String    @default("TRANSACTION_TYPE")
  city               String?
  district           String?
  neighborhood       String?
  roomCount          String?
  squareMeter        Float?
  floor              String?
  buildingFloorCount Int?
  price              Float?
  currency           String    @default("TRY")
  status             String    @default("DRAFT")
  confirmationStatus String    @default("WAITING")
  stateJson          Json?
  lastActivityAt     DateTime  @default(now())
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([expiresAt])
  @@index([lastActivityAt])
}

model AuditLog {
  id           String      @id @default(uuid())
  actorId      String?
  targetUserId String?
  action       AuditAction
  entityType   String
  entityId     String?
  description  String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())
  actor        User?       @relation("AuditActor", fields: [actorId], references: [id])
  targetUser   User?       @relation("AuditTargetUser", fields: [targetUserId], references: [id])
}

model UyelikPaketi {
  id                        String          @id @default(uuid())
  paketKodu                 UyelikPaketKodu @unique
  paketAdi                  String
  aciklama                  String?
  aktifPortfoyLimiti        Int
  aylikForumKonusuLimiti    Int?
  aylikMesajBaslatmaLimiti  Int?
  gunlukMesajBaslatmaLimiti Int?
  gunlukForumIlgiLimiti     Int?
  gunlukHavuzMesajLimiti    Int?
  verilenKontor             Int             @default(0)
  fiyat                     Decimal?
  paraBirimi                String          @default("TRY")
  aktifMi                   Boolean         @default(true)
  olusturulmaTarihi         DateTime        @default(now())
  guncellenmeTarihi         DateTime        @updatedAt

  @@index([paketKodu])
  @@index([aktifMi])
}

model KullaniciUyelikPaketi {
  id                String       @id @default(uuid())
  kullaniciId       String
  paketId           String
  durum             UyelikDurumu @default(AKTIF)
  baslangicTarihi   DateTime     @default(now())
  bitisTarihi       DateTime?
  pilotPaketMi      Boolean      @default(false)
  testPaketiMi      Boolean      @default(false)
  notlar            String?
  olusturulmaTarihi DateTime     @default(now())
  guncellenmeTarihi DateTime     @updatedAt

  @@index([kullaniciId])
  @@index([paketId])
  @@index([durum])
  @@index([baslangicTarihi])
  @@index([bitisTarihi])
}

model HediyeKontorHavuzu {
  id            String                 @id @default(uuid())
  kod           String                 @unique @default("GLOBAL")
  bakiye        Int                    @default(50000)
  toplamYukleme Int                    @default(50000)
  toplamDagitim Int                    @default(0)
  aktifMi       Boolean                @default(true)
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdBy     User?                  @relation("GiftPoolCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dagitimlar    HediyeKontorDagitimi[]

  @@index([aktifMi])
  @@index([createdById])
}

model HediyeKontorDagitimi {
  id            String             @id @default(uuid())
  havuzId       String
  gonderenId    String?
  aliciId       String?
  miktar        Int
  gonderenRol   Role
  adminKaynakli Boolean            @default(false)
  aciklama      String?
  createdAt     DateTime           @default(now())
  havuz         HediyeKontorHavuzu @relation(fields: [havuzId], references: [id], onDelete: Cascade)
  gonderen      User?              @relation("GiftCreditSender", fields: [gonderenId], references: [id], onDelete: SetNull)
  alici         User?              @relation("GiftCreditRecipient", fields: [aliciId], references: [id], onDelete: SetNull)

  @@index([havuzId])
  @@index([gonderenId])
  @@index([aliciId])
  @@index([adminKaynakli])
  @@index([createdAt])
}

model KontorCuzdani {
  id                String   @id @default(uuid())
  kullaniciId       String   @unique
  bakiye            Int      @default(0)
  toplamYukleme     Int      @default(0)
  toplamHarcama     Int      @default(0)
  toplamHediye      Int      @default(0)
  aktifMi           Boolean  @default(true)
  olusturulmaTarihi DateTime @default(now())
  guncellenmeTarihi DateTime @updatedAt

  @@index([kullaniciId])
  @@index([aktifMi])
}

model KontorHareketi {
  id                String            @id @default(uuid())
  kullaniciId       String
  hareketTuru       KontorHareketTuru
  islemTuru         KontorIslemTuru
  miktar            Int
  oncekiBakiye      Int
  sonrakiBakiye     Int
  aciklama          String?
  ilgiliKayitTuru   String?
  ilgiliKayitId     String?
  olusturanId       String?
  olusturulmaTarihi DateTime          @default(now())

  @@index([kullaniciId])
  @@index([hareketTuru])
  @@index([islemTuru])
  @@index([ilgiliKayitTuru])
  @@index([ilgiliKayitId])
  @@index([olusturulmaTarihi])
}

model PoolShareLink {
  id         String   @id @default(uuid())
  token      String   @unique
  unitId     String
  sharedById String
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([unitId])
  @@index([sharedById])
}

model NetworkPostShareLink {
  id         String   @id @default(uuid())
  token      String   @unique
  postId     String
  sharedById String
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([postId])
  @@index([sharedById])
}

model KotaKullanimi {
  id                String     @id @default(uuid())
  kullaniciId       String
  kotaKodu          String
  donem             KotaDonemi
  limit             Int
  kullanilan        Int        @default(0)
  donemBaslangic    DateTime
  donemBitis        DateTime
  olusturulmaTarihi DateTime   @default(now())
  guncellenmeTarihi DateTime   @updatedAt

  @@unique([kullaniciId, kotaKodu, donem, donemBaslangic])
  @@index([kullaniciId])
  @@index([kotaKodu])
  @@index([donem])
  @@index([donemBaslangic])
  @@index([donemBitis])
}

model MesajlasmaLimiti {
  id                           String          @id @default(uuid())
  paketKodu                    UyelikPaketKodu @unique
  gunlukYeniGorusmeLimiti      Int
  aylikYeniGorusmeLimiti       Int
  mevcutKonusmaCevapSinirsizMi Boolean         @default(true)
  gunlukForumIlgiLimiti        Int
  gunlukHavuzMesajLimiti       Int
  ekBesGorusmeKontoru          Int             @default(50)
  ekOnBesGorusmeKontoru        Int             @default(125)
  ekElliGorusmeKontoru         Int             @default(350)
  aktifMi                      Boolean         @default(true)
  olusturulmaTarihi            DateTime        @default(now())
  guncellenmeTarihi            DateTime        @updatedAt

  @@index([aktifMi])
}

model AdminDuyuru {
  id                  String           @id @default(uuid())
  olusturanId         String?
  mesajTuru           AdminMesajTuru
  baslik              String
  icerik              String
  hedefRol            String?
  hedefIl             String?
  hedefPaket          UyelikPaketKodu?
  hedefKullaniciId    String?
  yayindaMi           Boolean          @default(false)
  gonderildiMi        Boolean          @default(false)
  yayinTarihi         DateTime?
  sonGecerlilikTarihi DateTime?
  olusturulmaTarihi   DateTime         @default(now())
  guncellenmeTarihi   DateTime         @updatedAt

  @@index([olusturanId])
  @@index([mesajTuru])
  @@index([hedefRol])
  @@index([hedefIl])
  @@index([hedefPaket])
  @@index([hedefKullaniciId])
  @@index([yayindaMi])
  @@index([gonderildiMi])
}

model DestekTalebi {
  id                String            @id @default(uuid())
  kullaniciId       String
  baslik            String
  aciklama          String
  kategori          String?
  durum             DestekTalepDurumu @default(ACIK)
  oncelik           LinaGorevOnceligi @default(NORMAL)
  sonYanitTarihi    DateTime?
  kapanmaTarihi     DateTime?
  olusturulmaTarihi DateTime          @default(now())
  guncellenmeTarihi DateTime          @updatedAt

  @@index([kullaniciId])
  @@index([kategori])
  @@index([durum])
  @@index([oncelik])
}

model LinaOturum {
  id                String        @id @default(uuid())
  kullaniciId       String
  rolSnapshot       String?
  kanal             LinaKanal     @default(YAZILI)
  kaynakModul       LinaModul     @default(GENEL)
  durum             LinaDurum     @default(ISLENIYOR)
  oturumOzeti       String?
  mesajSayisi       Int           @default(0)
  inputTokenSayisi  Int           @default(0)
  outputTokenSayisi Int           @default(0)
  harcananKontor    Int           @default(0)
  sonAktiviteTarihi DateTime      @default(now())
  kapanmaTarihi     DateTime?
  gecerlilikTarihi  DateTime?
  silinmeTarihi     DateTime?
  olusturulmaTarihi DateTime      @default(now())
  guncellenmeTarihi DateTime      @updatedAt
  kullanici         User          @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  konusmalar        LinaKonusma[]
  hafizalar         LinaHafiza[]

  @@index([kullaniciId])
  @@index([kullaniciId, durum])
  @@index([kaynakModul])
  @@index([durum])
  @@index([sonAktiviteTarihi])
  @@index([gecerlilikTarihi])
  @@index([silinmeTarihi])
}

model LinaGunSonuOnayi {
  id                String             @id @default(uuid())
  kullaniciId       String
  tarih             DateTime           @db.Date
  gunlukOzet        String
  oturumIdleri      String[]           @default([])
  oturumSayisi      Int                @default(0)
  konusmaSayisi     Int                @default(0)
  secim             LinaGunSonuSecimi?
  durum             LinaDurum          @default(BEKLIYOR)
  onayTarihi        DateTime?
  olusturulmaTarihi DateTime           @default(now())
  guncellenmeTarihi DateTime           @updatedAt
  kullanici         User               @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  hafizalar         LinaHafiza[]

  @@unique([kullaniciId, tarih])
  @@index([kullaniciId])
  @@index([tarih])
  @@index([secim])
  @@index([durum])
}

model LinaKonusma {
  id                String             @id @default(uuid())
  kullaniciId       String?
  oturumId          String?
  siraNo            Int?
  rol               String?
  kanal             LinaKanal          @default(YAZILI)
  modul             LinaModul          @default(GENEL)
  niyet             LinaNiyet          @default(BELIRSIZ)
  kullaniciMesaji   String
  linaCevabi        String?
  ozet              String?
  inputTokenSayisi  Int                @default(0)
  outputTokenSayisi Int                @default(0)
  harcananKontor    Int                @default(0)
  belirsizlikVarMi  Boolean            @default(false)
  yetkiUygunMu      Boolean            @default(true)
  riskSeviyesi      LinaRiskSeviyesi   @default(YOK)
  firsatSeviyesi    LinaFirsatSeviyesi @default(YOK)
  durum             LinaDurum          @default(TAMAMLANDI)
  silinmeTarihi     DateTime?
  olusturulmaTarihi DateTime           @default(now())
  guncellenmeTarihi DateTime           @updatedAt
  oturum            LinaOturum?        @relation(fields: [oturumId], references: [id], onDelete: SetNull)

  @@unique([oturumId, siraNo])
  @@index([kullaniciId])
  @@index([kullaniciId, olusturulmaTarihi])
  @@index([oturumId])
  @@index([oturumId, olusturulmaTarihi])
  @@index([rol])
  @@index([modul])
  @@index([niyet])
  @@index([silinmeTarihi])
  @@index([olusturulmaTarihi])
}

model LinaBaglam {
  id                String    @id @default(uuid())
  kullaniciId       String?
  konusmaId         String?
  modul             LinaModul @default(GENEL)
  rol               String?
