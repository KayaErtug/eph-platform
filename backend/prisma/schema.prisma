generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                       @id @default(uuid())
  email                       String                       @unique
  phone                       String                       @unique
  passwordHash                String
  firstName                   String
  lastName                    String
  role                        Role
  isVerified                  Boolean                      @default(false)
  emailVerifiedAt             DateTime?
  emailVerificationCodeHash   String?
  emailVerificationExpiresAt  DateTime?
  emailVerificationAttempts   Int                          @default(0)
  emailVerificationLastSentAt DateTime?
  isApproved                  Boolean                      @default(false)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  nominationPoints            Int                          @default(0)
  nominationQuota             Int                          @default(10)
  referralCode                String?                      @unique
  adminVisible                Boolean                      @default(true)
  profileImageUrl             String?
  memberCode                  String?                      @unique
  memberSince                 DateTime?
  riskLevel                   RiskLevel                    @default(DUSUK)
  trustScore                  Int                          @default(70)
  city                        String?
  cityPlateCode               String?
  district                    String?
  hesapTuru                   KullaniciHesapTuru           @default(GERCEK)
  pilotKullaniciMi            Boolean                      @default(false)
  officeId                    String?
  activities                  Activity[]
  adminActionLogs             AdminActionLog[]             @relation("AdminActionActor")
  adminActionTargets          AdminActionLog[]             @relation("AdminActionTarget")
  applications                Application[]
  reviewedApplications        Application[]                @relation("ApplicationReviewer")
  auditLogs                   AuditLog[]                   @relation("AuditActor")
  activitiesAudited           AuditLog[]                   @relation("AuditTargetUser")
  ConversationParticipant     ConversationParticipant[]
  customers                   Customer[]
  documents                   Document[]
  linaPortfolioSessions       LinaPortfolioSession[]
  linaPreference              LinaPreference?
  Message                     Message[]
  NetworkNotification         NetworkNotification[]
  NetworkPost                 NetworkPost[]
  NetworkPostFollower         NetworkPostFollower[]
  NetworkPostUpdateLog        NetworkPostUpdateLog[]
  NetworkPostView             NetworkPostView[]
  nominations                 Nomination[]
  ownedOffices                Office[]                     @relation("OfficeOwner")
  announcementsCreated        PlatformAnnouncement[]       @relation("AnnouncementCreator")
  portfolioAuthorityApprovals PortfolioAuthorityDocument[] @relation("PortfolioAuthorityApprover")
  projects                    Project[]
  pushSubscriptions           PushSubscription[]
  reportsCreated              Report[]                     @relation("ReportReporter")
  reportsResolved             Report[]                     @relation("ReportResolver")
  superAdminProfile           SUPER_ADMIN?
  systemMessagesSent          SystemMessage[]              @relation("SystemMessageSender")
  systemMessagesInbox         SystemMessage[]              @relation("SystemMessageTargetUser")
  tasks                       Task[]
  ledTeams                    Team[]                       @relation("TeamLeader")
  teamMemberships             TeamMember[]
  office                      Office?                      @relation("OfficeUsers", fields: [officeId], references: [id])
  capabilitiesCreated         UserCapability[]             @relation("CapabilityCreator")
  capabilities                UserCapability[]             @relation("UserCapabilities")
  restrictionsCreated         UserRestriction[]            @relation("RestrictionCreator")
  restrictions                UserRestriction[]            @relation("RestrictedUser")
  visits                      UserVisit[]
  hediyeKontorHavuzlari       HediyeKontorHavuzu[]         @relation("GiftPoolCreator")
  hediyeKontorGonderimleri    HediyeKontorDagitimi[]       @relation("GiftCreditSender")
  hediyeKontorAlimlari        HediyeKontorDagitimi[]       @relation("GiftCreditRecipient")

  @@index([officeId])
}

model SUPER_ADMIN {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String   @default("Süper Admin")
  isActive    Boolean  @default(true)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Office {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerUserId String?
  city        String?
  district    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User?    @relation("OfficeOwner", fields: [ownerUserId], references: [id])
  teams       Team[]
  users       User[]   @relation("OfficeUsers")

  @@index([ownerUserId])
  @@index([city, district])
  @@index([isActive])
}

model Team {
  id        String       @id @default(uuid())
  officeId  String
  name      String
  leaderId  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  leader    User?        @relation("TeamLeader", fields: [leaderId], references: [id])
  office    Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@unique([officeId, name])
  @@index([officeId])
  @@index([leaderId])
  @@index([isActive])
}

model TeamMember {
  id        String    @id @default(uuid())
  teamId    String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([isActive])
}

model UserCapability {
  id          String     @id @default(uuid())
  userId      String
  capability  Capability
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   User?      @relation("CapabilityCreator", fields: [createdById], references: [id])
  user        User       @relation("UserCapabilities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId])
  @@index([capability])
  @@index([createdById])
}

model Invitation {
  id                   String            @id @default(uuid())
  code                 String            @unique
  role                 Role
  status               InvitationStatus  @default(PENDING)
  maxUses              Int               @default(1)
  usedCount            Int               @default(0)
  expiresAt            DateTime
  createdAt            DateTime          @default(now())
  adayAdSoyad          String?
  adayEposta           String?
  adayTelefon          String?
  davetKoduTuru        DavetKoduTuru     @default(REFERANSLI_BASVURU)
  epostaGonderildiMi   Boolean           @default(false)
  epostaGonderimTarihi DateTime?
  epostaHataMesaji     String?
  iptalEdenKullaniciId String?
  iptalSebebi          String?
  iptalTarihi          DateTime?
  olusturanKullaniciId String?
  olusturanRol         Role?
  onayYetkiSeviyesi    OnayYetkiSeviyesi @default(MODERATOR_ADMIN_SUPER_ADMIN)
  pilotDavetiMi        Boolean           @default(false)
  updatedAt            DateTime          @updatedAt

  @@index([role])
  @@index([status])
  @@index([davetKoduTuru])
  @@index([adayEposta])
  @@index([pilotDavetiMi])
  @@index([olusturanKullaniciId])
  @@index([olusturanRol])
  @@index([expiresAt])
}

model ReferralCandidate {
  id           String    @id @default(uuid())
  referralCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String    @unique
  role         Role
  isActive     Boolean   @default(true)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Document {
  id        String         @id @default(uuid())
  userId    String
  type      DocumentType
  status    DocumentStatus @default(PENDING)
  fileUrl   String
  fileName  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  city        String
  district    String
  address     String
  ownerId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  latitude    Float?
  longitude   Float?
  mapAddress  String?
  placeId     String?
  owner       User     @relation(fields: [ownerId], references: [id])
  units       Unit[]

  @@index([latitude, longitude])
  @@index([city, district])
}

model Unit {
  id                     String                       @id @default(uuid())
  projectId              String
  type                   UnitType                     @default(DAIRE)
  floor                  Int?
  number                 String?
  roomCount              String?
  area                   Float?
  price                  Float
  status                 UnitStatus                   @default(SATILIK)
  description            String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  isOffMarket            Boolean                      @default(false)
  isVerified             Boolean                      @default(false)
  photoVerified          Boolean                      @default(false)
  tapuVerified           Boolean                      @default(false)
  verifiedAt             DateTime?
  yetkiVerified          Boolean                      @default(false)
  floorLabel             String?
  priceCurrency          String?                      @default("TRY")
  totalFloors            Int?
  approvalNote           String?
  approvalStatus         PortfolioApprovalStatus      @default(TASLAK)
  approvedAt             DateTime?
  isPoolVisible          Boolean                      @default(false)
  poolPublishedAt        DateTime?
  poolRemovedAt          DateTime?
  rejectedAt             DateTime?
  submittedForApprovalAt DateTime?
  deedOwnerEmail         String?
  deedOwnerFullName      String?
  deedOwnerPhone         String?
  features               String[]                     @default([])
  availableCreditAmount  Float?
  doorAccessInfo         String?
  adaNo                  String?
  parselNo               String?
  customerProperties     CustomerProperty[]
  authorityLetters       EPHAuthorityLetter[]
  authorityDocuments     PortfolioAuthorityDocument[]
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images                 UnitImage[]

  @@index([approvalStatus])
  @@index([isPoolVisible])
  @@index([availableCreditAmount])
}

model UnitImage {
  id           String   @id @default(uuid())
  unitId       String
  url          String
  supabaseUrl  String?
  path         String
  bucket       String   @default("portfolio-images")
  originalName String?
  mimetype     String?
  size         Int?
  isCover      Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([isCover])
  @@index([sortOrder])
}

model PortfolioAuthorityDocument {
  id              String                 @id @default(uuid())
  unitId          String
  authorityType   PortfolioAuthorityType
  fileUrl         String
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  approved        Boolean                @default(false)
  approvedById    String?
  approvedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  documentSide    String?
  analyzedAt      DateTime?
  confidenceScore Int?
  documentType    String?
  linaSummary     String?
  ocrQualityScore Int?
  qrDetected      Boolean?
  riskLevel       String?
  approvedBy      User?                  @relation("PortfolioAuthorityApprover", fields: [approvedById], references: [id])
  unit            Unit                   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([authorityType])
  @@index([approved])
  @@index([approvedById])
  @@index([documentSide])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  targetUserId   String?
  entityType     String
  entityId       String?
  reason         String
  description    String?
  status         ReportStatus @default(ACIK)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@index([reporterId])
  @@index([targetUserId])
  @@index([status])
}

model UserRestriction {
  id          String          @id @default(uuid())
  userId      String
  createdById String
  type        RestrictionType
  reason      String
  isActive    Boolean         @default(true)
  startsAt    DateTime        @default(now())
  endsAt      DateTime?
  liftedAt    DateTime?
  liftedNote  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("RestrictionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  user        User            @relation("RestrictedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model AdminActionLog {
  id           String   @id @default(uuid())
  actorId      String?
  targetUserId String?
  action       String
  entityType   String
  entityId     String?
  description  String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AdminActionActor", fields: [actorId], references: [id])
  targetUser   User?    @relation("AdminActionTarget", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model TuranQuote {
  id          String   @id @default(uuid())
  text        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
}

model PlatformAnnouncement {
  id          String               @id @default(uuid())
  createdById String
  title       String
  content     String
  audience    AnnouncementAudience @default(TUM_UYELER)
  isActive    Boolean              @default(true)
  startsAt    DateTime             @default(now())
  endsAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([audience])
}

model SystemMessage {
  id                   String                  @id @default(uuid())
  senderId             String
  visibleSenderName    String                  @default("EPH Admin")
  targetType           SystemMessageTargetType
  targetUserId         String?
  targetRole           Role?
  category             SystemMessageCategory
  customCategory       String?
  title                String
  body                 String
  isRead               Boolean                 @default(false)
  readAt               DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  recipientCount       Int                     @default(0)
  targetCities         String[]
  targetCityPlateCodes String[]
  targetRoles          String[]
  sender               User                    @relation("SystemMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  targetUser           User?                   @relation("SystemMessageTargetUser", fields: [targetUserId], references: [id])

  @@index([senderId])
  @@index([targetUserId])
  @@index([targetRole])
  @@index([targetType])
  @@index([category])
  @@index([isRead])
  @@index([createdAt])
}

model Nomination {
  id             String           @id @default(uuid())
  nominatorId    String
  candidateName  String
  candidateEmail String
  candidatePhone String
  candidateRole  Role
  note           String?
  status         NominationStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  nominator      User             @relation(fields: [nominatorId], references: [id], onDelete: Cascade)
}

model Application {
  id                    String            @id @default(uuid())
  applicantName         String
  applicantEmail        String
  applicantPhone        String
  requestedRole         Role
  message               String?
  referralCode          String?
  referrerId            String?
  status                ApplicationStatus @default(PENDING)
  adminNote             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  city                  String?
  ipAddress             String?
  isRisky               Boolean           @default(false)
  isVip                 Boolean           @default(false)
  kvkkAccepted          Boolean           @default(false)
  legalAcceptedAt       DateTime?
  platformAccepted      Boolean           @default(false)
  privacyAccepted       Boolean           @default(false)
  profession            String?
  reviewedAt            DateTime?
  reviewedById          String?
  riskNote              String?
  userAgent             String?
  userAgreementAccepted Boolean           @default(false)
  basvuruTuru           BasvuruTuru       @default(REFERANSSIZ)
  district              String?
  epostaGonderildiMi    Boolean           @default(false)
  epostaGonderimTarihi  DateTime?
  epostaHataMesaji      String?
  invitationId          String?
  moderatorNote         String?
  onayYetkiSeviyesi     OnayYetkiSeviyesi @default(ADMIN_SUPER_ADMIN)
  onaylayanRol          Role?
  pilotBasvuruMu        Boolean           @default(false)
  referansDogrulandiMi  Boolean           @default(false)
  referansOlusturanId   String?
  referansliMi          Boolean           @default(false)
  rejectReason          String?
  rejectedAt            DateTime?
  rejectedById          String?
  referrer              User?             @relation(fields: [referrerId], references: [id])
  reviewedBy            User?             @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([applicantEmail])
  @@index([requestedRole])
  @@index([basvuruTuru])
  @@index([pilotBasvuruMu])
  @@index([referralCode])
  @@index([invitationId])
  @@index([referansliMi])
  @@index([referansOlusturanId])
  @@index([status])
  @@index([onayYetkiSeviyesi])
  @@index([reviewedById])
  @@index([createdAt])
}

model Lead {
  id           String   @id @default(uuid())
  fullName     String?
  phone        String?
  email        String?
  profession   String?
  city         String?
  interest     String?
  conversation String?
  source       String   @default("LINA")
  createdAt    DateTime @default(now())
}

model Customer {
  id              String             @id @default(uuid())
  ownerId         String
  firstName       String
  lastName        String
  phone           String?
  email           String?
  city            String?
  profession      String?
  company         String?
  budget          Float?
  interestedArea  String?
  interestedType  String?
  source          String?
  status          CustomerStatus     @default(YENI_LEAD)
  tags            String[]           @default([])
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  roles           CustomerRole[]     @default([])
  activities      Activity[]
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  interests       CustomerInterest[]
  properties      CustomerProperty[]
  tasks           Task[]

  @@index([ownerId])
  @@index([status])
  @@index([city])
  @@index([updatedAt])
}

model CustomerProperty {
  id           String                   @id @default(uuid())
  customerId   String
  unitId       String
  relationType CustomerPropertyRelation
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  customer     Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  unit         Unit                     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([customerId, unitId, relationType])
  @@index([customerId])
  @@index([unitId])
  @@index([relationType])
  @@index([createdAt])
}

model CustomerInterest {
  id             String                   @id @default(uuid())
  customerId     String
  title          String?
  city           String?
  district       String?
  neighborhood   String?
  propertyTypes  UnitType[]               @default([])
  statuses       UnitStatus[]             @default([])
  minBudget      Float?
  maxBudget      Float?
  priceCurrency  String                   @default("TRY")
  minArea        Float?
  maxArea        Float?
  roomCounts     String[]                 @default([])
  features       String[]                 @default([])
  purchaseIntent CustomerPurchaseIntent   @default(BELIRSIZ)
  priority       CustomerInterestPriority @default(NORMAL)
  notes          String?
  isActive       Boolean                  @default(true)
  lastMatchedAt  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  customer       Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([city, district, neighborhood])
  @@index([isActive])
  @@index([priority])
  @@index([purchaseIntent])
  @@index([createdAt])
}

model Activity {
  id         String       @id @default(uuid())
  customerId String
  userId     String
  type       ActivityType
  note       String
  createdAt  DateTime     @default(now())
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id         String     @id @default(uuid())
  customerId String
  userId     String
  title      String
  dueDate    DateTime?
  status     TaskStatus @default(BEKLIYOR)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserVisit {
  id        String   @id @default(uuid())
  userId    String?
  page      String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Conversation {
  id                      String                    @id
  postId                  String?
  title                   String
  status                  ConversationStatus        @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  NetworkPost             NetworkPost?              @relation(fields: [postId], references: [id])
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

model ConversationParticipant {
  id             String       @id
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  lastReadAt     DateTime?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model NetworkPost {
  id           String                 @id
  userId       String
  type         String
  title        String
  description  String
  city         String?
  district     String?
  neighborhood String?
  budget       Float?
  urgency      String?
  visibility   NetworkVisibility      @default(TUM_EPH)
  tags         String[]
  expiresAt    DateTime
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime
  Conversation Conversation[]
  User         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers    NetworkPostFollower[]
  updateLogs   NetworkPostUpdateLog[]
  views        NetworkPostView[]
}

model NetworkPostUpdateLog {
  id        String      @id @default(uuid())
  postId    String
  userId    String
  summary   String
  changes   Json
  createdAt DateTime    @default(now())
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetworkPostFollower {
  id        String      @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model NetworkPostView {
  id        String      @id @default(uuid())
  postId    String
  userId    String?
  createdAt DateTime    @default(now())
  post      NetworkPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model NetworkNotification {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
