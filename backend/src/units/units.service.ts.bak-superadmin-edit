  private getClassicPortfolioProjectWhere() {
    return {
      code: null,
      declaredIndependentUnitCount: null,
      declaredSalesInventoryCount: null,
      plannedUnitTypes: {
        isEmpty: true,
      },
      blocks: {
        none: {},
      },
      mediaPackages: {
        none: {},
      },
      designReviewRequests: {
        none: {},
