  private async getPoolUnitWithProjectOrFail(id: string) {
    const unit = await this.prisma.unit.findUnique({
      where: { id },
      include: {
        project: {
          include: {
            authorizedContact: true,
            owner: {
              select: {
                id: true,
                firstName: true,
                lastName: true,
                role: true,
                companyName: true, phone: true, office: { select: { id: true, name: true, city: true, district: true, neighborhood: true, ownerUserId: true, owner: { select: { id: true, firstName: true, lastName: true, phone: true } } } },
              },
            },
          },
        },
      },
    });

    if (!unit) {
      throw new NotFoundException('Portföy bulunamadı.');
    }

    if (!this.isProjectVisibleInPool(unit.project)) {
      throw new BadRequestException('Bu portfÃ¶y ÅŸu anda Havuz iÃ§inde aktif deÄŸil.');
    }

    if (!unit.project.isActive || !countsAgainstActivePortfolioLimit(unit.status) || !unit.isPoolVisible || unit.approvalStatus !== PortfolioApprovalStatus.HAVUZDA) {
      throw new BadRequestException('Bu portföy şu anda Havuz içinde aktif değil.');
    }

    await this.attachOfficeProfilePhones([unit]);
    return unit;
  }

  // Ofis telefonu Office tablosunda değil, SystemSetting EPH_OFFICE_PROFILE_<officeId> içinde tutulur.
  private async attachOfficeProfilePhones(units: any[]) {
    const offices = units.map((unit) => unit.project?.owner?.office).filter((office) => office?.id);
    if (!offices.length) return;
    const rows = await this.prisma.systemSetting.findMany({
      where: { key: { in: [...new Set(offices.map((office) => officeProfileKey(office.id)))] } },
    });
    const profiles = new Map(rows.map((row) => [row.key, officeProfile(row.valueJson)]));
    for (const office of offices) {
      const profile = profiles.get(officeProfileKey(office.id));
      office.profilePhone = profile?.phone || null;
      office.profileAddress = profile?.address || null;
    }
  }

  private getEphId(id: string) {
    const cleaned = String(id || '').replace(/-/g, '').slice(0, 6).toUpperCase();
    return `EPH-${cleaned || '000000'}`;
  }

  private async getOrCreateKontorWallet(userId: string) {
    userId = (await resolveOfficeWallet(this.prisma, userId)).chargeUserId;
    let wallet = await this.prisma.kontorCuzdani.findUnique({
      where: {
        kullaniciId: userId,
      },
    });

    if (!wallet) {
      wallet = await this.prisma.kontorCuzdani.create({
        data: {
          kullaniciId: userId,
          bakiye: 0,
          toplamYukleme: 0,
          toplamHarcama: 0,
          toplamHediye: 0,
          aktifMi: true,
        },
      });
    }

    return wallet;
