import { Prisma } from '@prisma/client';

/**
 * EPH-70B1: ortak PK cüzdanı kilidi + lot (PortfolioCreditLot) tüketim kuralları.
 *
 * TEK KİLİT SIRASI (iade, harcama, yükleme, lot değişimi, dönem sonu düşümü, mağaza iadesi):
 *   1) pg_advisory_xact_lock(hashtext('wallet:{kullaniciId}'))
 *   2) SELECT ... FROM "KontorCuzdani" WHERE "kullaniciId" = ... FOR UPDATE
 *   3) bakiye/lotlar kilitten SONRA okunur, düşüm bu güncel değerle hesaplanır.
 * Kilit sırası değişmez; başka kilit (payment-user, store-apple-*, PaymentOrder) cüzdan kilidinden ÖNCE alınır.
 */

export type WalletLotLike = {
  id: string;
  lotTuru: string;
  kalanMiktar: number;
  ilkMiktar?: number;
  sonKullanmaTarihi: Date | null;
  olusturulmaTarihi?: Date;
};

export async function lockWallet(tx: Prisma.TransactionClient, userId: string) {
  await tx.$executeRaw`SELECT pg_advisory_xact_lock(hashtext(${`wallet:${userId}`}))`;
  await tx.$queryRaw`SELECT "id" FROM "KontorCuzdani" WHERE "kullaniciId" = ${userId} FOR UPDATE`;
  return tx.kontorCuzdani.findUnique({ where: { kullaniciId: userId } });
}

/**
 * Tüketim önceliği (§11 madde 6):
 *  1) süresi olan PAKET/DENEME lotları — bitişi en yakın olan önce
 *  2) süresiz, EK PK olmayan lotlar (DEVIR, HEDIYE, ...) — eskiden yeniye
 *  3) süresiz EK PK lotu (SATIN_ALMA) — en son
 */
export function lotRank(lot: WalletLotLike): [number, number, number] {
  const created = lot.olusturulmaTarihi ? lot.olusturulmaTarihi.getTime() : 0;
  if (lot.sonKullanmaTarihi) return [0, lot.sonKullanmaTarihi.getTime(), created];
  if (lot.lotTuru === 'SATIN_ALMA') return [2, 0, created];
  return [1, 0, created];
}

export function sortLotsForConsumption<T extends WalletLotLike>(lots: T[]): T[] {
  return [...lots].sort((a, b) => {
    const ra = lotRank(a); const rb = lotRank(b);
    return ra[0] - rb[0] || ra[1] - rb[1] || ra[2] - rb[2] || a.id.localeCompare(b.id);
  });
}

/** Saf hesap: amount'u sıralı lotlardan düşer. Lotlarda karşılığı olmayan kısım (eski/izlenmeyen bakiye) `untracked`. */
export function planConsumption<T extends WalletLotLike>(lots: T[], amount: number) {
  let left = amount;
  const steps: Array<{ lot: T; take: number }> = [];
  for (const lot of sortLotsForConsumption(lots)) {
    if (left <= 0) break;
    const take = Math.min(lot.kalanMiktar, left);
    if (take > 0) { steps.push({ lot, take }); left -= take; }
  }
  return { steps, untracked: left };
}

/** Kilit ALTINDA çağrılmalı. Süresi geçmiş / pasif lotlar tüketilmez. */
export async function consumeLots(tx: Prisma.TransactionClient, userId: string, amount: number, now = new Date()) {
  const lots = await tx.portfolioCreditLot.findMany({
    where: { kullaniciId: userId, aktifMi: true, kalanMiktar: { gt: 0 }, OR: [{ sonKullanmaTarihi: null }, { sonKullanmaTarihi: { gt: now } }] },
  });
  const plan = planConsumption(lots as WalletLotLike[], amount);
  for (const step of plan.steps) {
    await tx.portfolioCreditLot.update({ where: { id: step.lot.id }, data: { kalanMiktar: { decrement: step.take } } });
  }
  return plan;
}

/** Başarısız işlem iadesi: bakiyeye dönen PK, tüketim sırasıyla (ilkMiktar'ı aşmadan) lotlara geri yazılır. */
export async function restoreLots(tx: Prisma.TransactionClient, userId: string, amount: number, now = new Date()) {
  const lots = await tx.portfolioCreditLot.findMany({
    where: { kullaniciId: userId, aktifMi: true, OR: [{ sonKullanmaTarihi: null }, { sonKullanmaTarihi: { gt: now } }] },
  });
  let left = amount;
  for (const lot of sortLotsForConsumption(lots as WalletLotLike[])) {
    if (left <= 0) break;
    const room = Math.max(0, (lot.ilkMiktar ?? 0) - lot.kalanMiktar);
    const give = Math.min(room, left);
    if (give > 0) { await tx.portfolioCreditLot.update({ where: { id: lot.id }, data: { kalanMiktar: { increment: give } } }); left -= give; }
  }
  return { untracked: left };
}

/**
 * Uzlaştırma / dönem sonu yardımcısı (saf): bakiye < Σ lot kalanı ise farkı tüketim sırasıyla lotlardan düşer.
 * Dönem sonu düşümünde (expiry) kullanılan hedef: bitmiş PAKET lotlarının kalanı.
 */
export function planReconciliation<T extends WalletLotLike>(lots: T[], balance: number) {
  const sum = lots.reduce((s, l) => s + l.kalanMiktar, 0);
  const excess = Math.max(0, sum - Math.max(0, balance));
  return planConsumption(lots, excess);
}
