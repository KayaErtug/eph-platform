+    $executeRaw: jest.fn(async () => 1),
+    kotaKullanimi: { upsert: jest.fn(async () => ({ id: 'quota', kullanilan: state.used })), update: jest.fn(async () => ({})) },
+  };
+  return { db, state };
+}
